DISCORD_TOKEN=replace_with_your_bot_token
CONFIG_PATH=./config.json
DATA_DIR=./data
PLUGIN_DIR=./plugins
# Optional private OAuth viewer (never host logs on GitHub Pages).
# LOG_VIEWER_URL=https://logs.example.com
# LOG_VIEWER_HOST=127.0.0.1
# LOG_VIEWER_PORT=8787
# DISCORD_CLIENT_ID=your_application_id
# DISCORD_CLIENT_SECRET=your_private_oauth_client_secret

# Console logs are purple by default; the rotating data/logs/modmail.log stays plain.
# LOG_COLOR=false
